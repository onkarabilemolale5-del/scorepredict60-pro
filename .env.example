# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_API_FOOTBALL_KEY: API-Football (api-football.com / v3.football.api-sports.io)
# Get a free key at https://dashboard.api-football.com/register
# In Vercel, add this under Settings > Environment Variables
NEXT_PUBLIC_API_FOOTBALL_KEY=""
